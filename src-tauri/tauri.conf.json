{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.0",
  "identifier": "app.pulse.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420/panel.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "fhfanshu",
    "copyright": "Copyright (c) 2026 contributors of this port. Based on Pulse by qunqin24 (Apache-2.0).",
    "category": "Utility",
    "homepage": "https://github.com/FHfanshu/Pulse-Windows",
    "shortDescription": "Pulse — AI 编程额度监视器",
    "longDescription": "把 Claude Code、Codex、Cursor 等 AI 编程工具的额度、重置时间和 Token 消耗放在屏幕边缘。A Windows monitor for AI coding plan limits, token usage and estimated spend.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
